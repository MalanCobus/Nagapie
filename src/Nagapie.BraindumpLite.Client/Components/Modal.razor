@inject IJSRuntime JS
@inject IStringLocalizer<AppResources> L
@implements IAsyncDisposable
<dialog @ref="dialog" class="modal" aria-labelledby="@titleId" @onclose="OnClosed" @oncancel="OnClosed">
    <div class="modal-heading"><h2 id="@titleId">@Title</h2><button type="button" class="icon-button" aria-label="@L["Common_Close"]" @onclick="OnClosed"><Icon Name="close"/></button></div>
    @ChildContent
</dialog>
