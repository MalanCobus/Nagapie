@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject IStringLocalizer<AppResources> L
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AccountClient Accounts
@inject AccountContext Account
<a class="skip-link" href="#main">@L["Nav_Skip"]</a>
<header class="site-header">
    <a href="/" class="brand" aria-label="Braindump"><span class="brand-mark"><Icon Name="leaf" Size="29"/></span>Braindump<span class="brand-dot">.</span></a>
    <nav class="top-nav">
    @if (Account.IsAuthenticated)
    {
        <NavLink href="/" Match="NavLinkMatch.All" aria-label="@L["Nav_Dump"]"><Icon Name="edit"/><span>@L["Nav_Dump"]</span></NavLink>
        <NavLink href="/list" aria-label="@L["Nav_List"]"><Icon Name="list"/><span>@L["Nav_List"]</span></NavLink>
        <NavLink href="/settings" class="settings-link" aria-label="@L["Nav_Settings"]"><Icon Name="settings"/></NavLink>
        <NavLink href="/dumps">@L["Account_Dumps"]</NavLink>
        <button class="text-button" @onclick="LogoutAsync">@L["Account_Logout"]</button>
    }
    </nav>
</header>
<main id="main" class="main-content">
@if (new Uri(Nav.Uri).AbsolutePath is "/privacy" or "/terms") { @Body }
else if (!accountReady) { <div class="loading-screen"><Icon Name="leaf" Size="44"/><p>@L["Common_Loading"]</p></div> }
else if (accountError is not null) { <ErrorMessage Code="@accountError"/><button class="button secondary" @onclick="Reload">@L["Account_Retry"]</button> }
else if (!Account.IsAuthenticated) { <AccountForm Register="@(new Uri(Nav.Uri).AbsolutePath == "/register")" /> }
else if (!State.Loaded) { <div class="loading-screen"><p>@L["Common_Loading"]</p></div> }
else if (State.StorageFailed) {
    <ErrorMessage Code="STORAGE_INVALID"/>
    <button class="button secondary" @onclick="Reload">@L["Account_Retry"]</button>
}
else { @Body }
</main>
<footer class="site-footer"><span><Icon Name="leaf" Size="16"/> @L["Nav_Tagline"]</span><div><a href="/privacy">@L["Nav_Privacy"]</a><span>·</span><a href="/terms">@L["Nav_Terms"]</a></div></footer>
