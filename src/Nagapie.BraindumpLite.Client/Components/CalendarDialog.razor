@inherits PageBase
<Modal Title="@L["Calendar_Title"]" Closed="Closed">
<p>@L["Calendar_Hint"]</p>
<label class="field-label">@L["Calendar_Date"]<input type="date" @bind="date"/></label>
<label class="checkbox"><input type="checkbox" @bind="allDay"/>@L["Calendar_AllDay"]</label>
@if (!allDay) { <div class="field-row"><label>@L["Calendar_Start"]<input type="time" @bind="start" /></label><label>@L["Calendar_End"]<input type="time" @bind="end"/></label></div> }
<ErrorMessage Code="@Error"/>
<div class="modal-actions"><button class="button secondary" autofocus @onclick="() => Closed.InvokeAsync()">@L["Common_Cancel"]</button><button class="button primary" @onclick="DownloadAsync">@L["Calendar_Download"]</button></div>
</Modal>
