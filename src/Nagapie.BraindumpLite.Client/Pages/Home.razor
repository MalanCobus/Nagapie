@page "/"
@inherits PageBase
@implements IAsyncDisposable
<PageTitle>Braindump — @L["Nav_Dump"]</PageTitle>
<StepIndicator Active="0"/>
<section class="hero">
    <div><p class="eyebrow">@L["Dump_Eyebrow"]</p><h1>@L["Dump_Title"]</h1><p class="lead">@L["Dump_Subtitle"]</p></div><Botanical/>
</section>
@if (State.Draft.Review is not null) {
    <div class="notice resume"><span>@L["Dump_Resume"]</span><a href="@("/review/" + State.Draft.Id)">@L["Dump_ResumeAction"] <span aria-hidden="true">→</span></a></div>
}
<section class="dump-card">
    <div class="card-heading"><label for="braindump">@L["Dump_Label"]</label><Icon Name="spark"/></div>
    <textarea id="braindump" class="dump-input" maxlength="5000" placeholder="@L["Dump_Placeholder"]" value="@State.Draft.Text" @oninput="InputAsync" disabled="@Busy" aria-describedby="dump-hint"></textarea>
    <div class="input-bottom"><span id="dump-hint">@L["Dump_Hint"]</span><span class="char-count">@State.Draft.Text.Length.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo(State.Settings.Language)) / @(5000.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo(State.Settings.Language)))</span></div>
    <div class="card-actions">
        @if (speechSupported) { <button class="button speech @(listening ? "recording" : "")" disabled="@Busy" @onclick="SpeechAsync"><Icon Name="mic"/>@(listening ? L["Speech_Stop"] : L["Speech_Start"])</button> }
        else { <span class="quiet-note"><Icon Name="leaf" Size="17"/>@L["Dump_Empty"]</span> }
        <button class="button primary" @onclick="SortAsync" disabled="@(Busy || string.IsNullOrWhiteSpace(State.Draft.Text))"><Icon Name="spark"/>@L["Dump_Sort"]<Icon Name="arrow" Size="18"/></button>
    </div>
</section>
<div class="draft-meta"><span><span class="status-dot"></span>@(saving ? L["Dump_Saving"] : savedDraftText != State.Draft.Text ? L["Dump_NotSaved"] : State.Draft.Text.Length > 0 ? L["Dump_Saved"] : L["Dump_Local"])</span><span><Icon Name="lock" Size="13"/>@L["Dump_Control"]</span></div>
@if (listening) { <div class="notice" role="status">@L["Speech_Listening"]</div> }
@if (Busy) { <div class="processing" role="status"><span class="spinner"></span><div><strong>@L["Dump_Processing"]</strong><p>@L["Dump_ProcessingDetail"]</p></div><button class="text-button" @onclick="Cancel">@L["Dump_Cancel"]</button></div> }
<ErrorMessage Code="@Error"/>
@if (Error is not null || !State.Config.AiAvailable) {
    @if (Error is null) { <p class="connection-note">@L["Dump_AiUnavailable"]</p> }
    <button class="text-button fallback" @onclick="SaveOneAsync" disabled="@(Busy || string.IsNullOrWhiteSpace(State.Draft.Text))">@L["Dump_SaveOne"] <span aria-hidden="true">↗</span></button>
}
<div class="inspiration">
    <div><span class="tiny-spark">✧</span><span>@L["Dump_Example"]</span></div><button class="text-button" disabled="@(Busy || State.Draft.Text.Length > 0)" @onclick="ExampleAsync">@L["Dump_UseExample"] <span aria-hidden="true">↗</span></button>
</div>
<div class="thought-prompts"><span><span class="prompt-dot sage"></span>@L["Dump_Prompt1"]</span><span><span class="prompt-dot yellow"></span>@L["Dump_Prompt2"]</span><span><span class="prompt-dot terra"></span>@L["Dump_Prompt3"]</span></div>
@if (State.Config.PaywallEnabled && State.Access.UnlockToken is null) { <p class="quiet-note">@State.SuccessfulAiDumps @L["Access_Count"]</p> }
@if (consent) {
    <Modal Title="@L["Consent_Title"]" Closed="() => consent = false"><p>@L["Consent_Text", State.Config.ProviderName]</p><p><a href="@State.Config.ProviderPrivacyUrl" target="_blank" rel="noopener noreferrer">@L["Consent_Provider"]</a> · <a href="/privacy">@L["Nav_Privacy"]</a></p><div class="modal-actions"><button class="button secondary" autofocus @onclick="WithoutAiAsync">@L["Consent_Without"]</button><button class="button primary" @onclick="ConsentAsync">@L["Consent_Agree"]</button></div></Modal>
}
@if (speechConsent) {
    <Modal Title="@L["Speech_Title"]" Closed="() => speechConsent = false"><p>@L["Speech_Notice"]</p><div class="modal-actions"><button class="button secondary" autofocus @onclick="() => speechConsent = false">@L["Common_Cancel"]</button><button class="button primary" @onclick="StartSpeechAsync">@L["Speech_Agree"]</button></div></Modal>
}
