@page "/unlock"
@inherits PageBase
<PageTitle>Braindump — @L["Access_Title"]</PageTitle>
<section class="welcome"><Botanical/><h1>@L["Access_Title"]</h1>
@if (!State.Config.PaywallEnabled) { <p class="lead">@L["Access_Test"]</p><a class="button primary" href="/">@L["List_New"]</a> }
else if (State.Access.UnlockToken is not null && success) { <p class="lead">@L["Access_Unlocked"]</p><a class="button primary" href="/">@L["List_New"]</a> }
else { <p class="lead">@L["Access_Text"]</p>
@if (Uri.TryCreate(State.Config.PayhipProductUrl, UriKind.Absolute, out var url) && url.Scheme == "https") { <a class="button primary" href="@url" target="_blank" rel="noopener noreferrer">@L["Access_Buy"]<Icon Name="arrow"/></a> } else { <p>@L["Access_NotConfigured"]</p> }
<div class="settings-card"><label for="license">@L["Access_Key"]</label><input id="license" maxlength="100" autocomplete="off" @bind="key" @bind:event="oninput"/><ErrorMessage Code="@Error"/><button class="button secondary" disabled="@(Busy || string.IsNullOrWhiteSpace(key))" @onclick="VerifyAsync">@L["Access_Verify"]</button></div>
}
</section>
