@page "/privacy"
@inherits PageBase
<PageTitle>Nagapie — @L["Privacy_Title"]</PageTitle>
<article class="prose"><p class="eyebrow">NAGAPIE</p><h1>@L["Privacy_Title"]</h1><p>@L["Privacy_Intro"]</p><h2>@L["Settings_Ai"]</h2><p>@L["Privacy_Ai"]</p><p><a href="@State.Config.ProviderPrivacyUrl" target="_blank" rel="noopener noreferrer">@State.Config.ProviderName — @L["Consent_Provider"]</a></p><h2>@L["Speech_Title"]</h2><p>@L["Speech_Notice"]</p><h2>@L["Settings_Version"]</h2><p>@L["Privacy_Test"]</p><a href="mailto:hello@nagapie.nl">@L["Settings_Contact"]</a></article>
