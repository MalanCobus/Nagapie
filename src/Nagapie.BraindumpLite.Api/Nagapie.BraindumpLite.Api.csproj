<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\Nagapie.BraindumpLite.Contracts\Nagapie.BraindumpLite.Contracts.csproj" />
    <ProjectReference Include="..\Nagapie.BraindumpLite.Client\Nagapie.BraindumpLite.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>be1c8238-5870-4798-9410-d7042eeea2d9</UserSecretsId>
  </PropertyGroup>
  <Target Name="RequireDeploymentPipeline" BeforeTargets="PrepareForPublish;MSDeployPublish;WebPublish;PublishOnly"
          Condition="'$(WebPublishMethod)' == 'MSDeploy' Or '$(WebPublishMethod)' == 'ZipDeploy' Or '$(PublishProvider)' == 'AzureWebSite'">
    <Error Text="Direct Azure publishing is disabled because it bypasses database upgrades. Run the GitHub Actions 'Deploy application' workflow. See docs/sql-and-accounts.md. Local folder publishing remains available." />
  </Target>
</Project>
